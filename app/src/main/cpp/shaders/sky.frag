#version 450

layout(set = 0, binding = 0) uniform CameraUbo {
    mat4 viewProj;
    mat4 invViewProj;
    vec4 cameraPos;
    vec4 screenSize;
    vec4 sunDir;
    vec4 fogParams;
    vec4 skyColor;     // цвет неба, sRGB; w — доля дня, 0 ночь, 1 день
    // Свет суток, посчитанный ОДИН раз за кадр в render::Camera::toUbo.
    // Раньше каждый фрагментный шейдер считал это сам, на каждый
    // пиксель, хотя зависит оно только от uniform. См. CameraUbo.
    vec4 sunLight;     // rgb — цвет солнца, линейный; w — день x над горизонтом
    vec4 ambLight;     // rgb — оттенок рассеянного света; w — его сила
    vec4 skyLinear;    // rgb — цвет неба, линейный; w — солнце над горизонтом
    // Погода. weather: x — доля неба под тучами, y — сила осадков,
    // z — яркость радуги, w — снег (0 дождь, 1 снег).
    // wind: xy — ветер в блоках в секунду, z — время в секундах.
    vec4 weather;
    vec4 wind;

    // ---- Точечные источники: факелы, фонари, огонь в руке ----
    //
    // lightInfo.x — сколько источников прислали. Ноль — цикл в
    // шейдере не выполняется ни разу.
    vec4 lightInfo;
    vec4 lightPos[8];    // xyz — где, w — радиус гашения
    vec4 lightColor[8];  // rgb — цвет, линейный; w — яркость
} cam;

layout(location = 0) out vec4 outColor;

// Небо считается в том же линейном пространстве, что и мир: у
// горизонта туман должен переходить в небо незаметно, а он приходит
// оттуда линейным. Разные пространства дали бы видимый стык по
// линии горизонта.
vec3 toLinear(vec3 c) { return c * c; }
vec3 toSrgb(vec3 c)   { return sqrt(max(c, vec3(0.0))); }

// pow с основанием, которое бывает нулём, не определён: везде он
// считается как exp2(k * log2(x)), а log2(0) = -inf, и что вернёт
// драйвер дальше — его дело. На устройстве это стоило целой дальней
// половины кадра (см. voxel.frag). Основание подпирается снизу: для
// показателей, которые тут стоят, разница ниже кванта цвета.
float powSafe(float x, float k) { return pow(max(x, 1e-4), k); }

// ============================================================
// Тучи
// ============================================================
//
// Слой облаков — плоскость на фиксированной высоте над камерой. Луч
// упирается в неё тем дальше, чем ниже смотришь, поэтому у горизонта
// облака сами собой сходятся в сплошную полосу — ровно так они и
// выглядят с земли.
//
// Объёмных облаков здесь нет и быть не может: марш по лучу стоит
// десятков выборок на пиксель, а небо и без того самый дорогой
// шейдер кадра.
float hash21(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float vnoise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash21(i);
    float b = hash21(i + vec2(1.0, 0.0));
    float c = hash21(i + vec2(0.0, 1.0));
    float d = hash21(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// Три октавы: одна даёт ровные пятна, пять стоят вдвое дороже и на
// глаз от трёх не отличаются.
//
// Возвращает ОБЕ величины, которые нужны небу, за ту же цену:
//   x — плотность, сумма всех трёх октав;
//   y — базовая октава отдельно.
//
// Базовая нужна затенению: сравнивать трёхоктавную сумму с
// одноктавной пробой было бы сравнением разных величин, и «тень»
// вышла бы шумом. Раньше функция складывала октавы и теряла их —
// а разложить сумму обратно нельзя.
vec2 cloudField(vec2 p) {
    float base = vnoise(p) * 0.55;
    float v = base;
    v += vnoise(p * 2.13 + vec2(37.1, 11.7)) * 0.28;
    v += vnoise(p * 4.41 + vec2(91.3, 63.9)) * 0.17;
    return vec2(v, base);
}

// Цвет радуги по углу внутри дуги: 0 — внутренний край (фиолетовый),
// 1 — внешний (красный). Не спектр по длине волны, а три полосы:
// в пять-шесть градусов дуги подробнее всё равно не видно.
vec3 rainbowTint(float t) {
    vec3 c = mix(vec3(0.35, 0.10, 0.70), vec3(0.10, 0.55, 0.35),
                 smoothstep(0.0, 0.45, t));
    c = mix(c, vec3(0.95, 0.75, 0.15), smoothstep(0.40, 0.75, t));
    c = mix(c, vec3(0.95, 0.25, 0.12), smoothstep(0.70, 1.0, t));
    return c;
}

vec3 shoulder(vec3 c) {
    float m = max(max(c.r, c.g), c.b);
    if (m <= 0.75) return c;
    float o = m - 0.75;
    return c * ((0.75 + o / (1.0 + o * 2.0)) / m);
}

void main() {
    // NDC из gl_FragCoord. В Vulkan начало кадра — левый ВЕРХНИЙ угол,
    // и там же -1 по Y, поэтому перевод прямой, без переворота.
    vec2 uv  = gl_FragCoord.xy / cam.screenSize.xy;
    vec2 ndc = uv * 2.0 - 1.0;

    vec4 nearH = cam.invViewProj * vec4(ndc, 0.0, 1.0);
    vec4 farH  = cam.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 dir = normalize(farH.xyz / farH.w - nearH.xyz / nearH.w);

    // Свет суток приходит готовым: считает его render::Camera::toUbo,
    // раз в кадр, и одинаково для неба, ландшафта, травы и существ.
    float night   = 1.0 - cam.skyColor.w;
    float above   = cam.skyLinear.w;
    vec3  sunTint = cam.sunLight.rgb;

    // Градиент от горизонта к зениту. Базовый цвет приходит из
    // world::DayCycle, поэтому небо само меняется от ночного индиго
    // к рассветному янтарю и дневной лазури.
    float up = clamp(dir.y, -1.0, 1.0);
    vec3 horizon = cam.skyLinear.rgb;
    vec3 zenith  = horizon * vec3(0.42, 0.60, 1.10);
    vec3 sky = mix(horizon, zenith, powSafe(clamp(up, 0.0, 1.0), 0.55));

    // Под горизонтом — земляная дымка: без неё при взгляде вниз
    // сквозь дальний край мира светит чистое небо, и видно, где он
    // кончается.
    // smoothstep(0.0, -0.25, up) стоял с edge0 БОЛЬШЕ edge1, а это по
    // спецификации неопределено. Обычная реализация считает то, что
    // задумано, но полагаться на неё нельзя — и стоит она ровно
    // столько же, если развернуть край руками.
    sky = mix(sky, horizon * 0.55, 1.0 - smoothstep(-0.25, 0.0, up));

    // Тёплая полоса у самого горизонта в стороне солнца — то, из-за
    // чего рассвет читается как рассвет.
    float toSun = max(dot(normalize(vec3(dir.x, 0.0, dir.z)),
                          normalize(vec3(cam.sunDir.x, 0.0, cam.sunDir.z))), 0.0);
    sky = mix(sky, sunTint, exp(-abs(up) * 7.0) * (toSun * toSun * toSun) * 0.55 * above);

    // Звёзды проступают, когда небесный свет падает.
    if (night > 0.01 && up > 0.0) {
        vec3 g = floor(dir * 260.0);
        float h = fract(sin(dot(g, vec3(12.9898, 78.233, 37.719))) * 43758.5453);
        // Неравная яркость: ровная сетка одинаковых точек читается
        // как шум, а не как небо.
        float mag = fract(h * 91.7);
        float star = step(0.9990, h) * night * up * (0.35 + 0.65 * mag);
        sky += vec3(star) * vec3(0.85, 0.90, 1.0);
    }

    // ---- солнце и луна ----
    //
    // Небо — самый дорогой шейдер кадра на пиксель: 8.5 мс на полный
    // экран, 3.4 нс на пиксель, дороже фрагментной математики
    // ландшафта. Дороги в нём степени: пять `pow` на диски и ореолы.
    //
    // Ветвь здесь НЕ РАБОТАЕТ, и это измерено, а не предположено.
    // Прошлая редакция прятала диск и ореол под `if (d > 0.70)`: на
    // хосте это снимало 27% шейдера, на устройстве — ноль (8.57 -> 8.49
    // и 8.38, при разбросе самого замера 0.11). А удаление тех же
    // членов БЕЗУСЛОВНО снимало 1.77 мс, то есть 21%. Вывод один:
    // арифметика дорога, но драйвер разворачивает короткую ветвь в
    // предикаты — считает обе стороны и выбирает. Пропустить работу
    // условием на этом GPU нельзя, её можно только не делать.
    //
    // Поэтому здесь нет ни одной ветви, а есть три приёма:
    //
    //   1. Широкое сияние — шестая степень тремя умножениями. Оно
    //      заметно далеко от солнца, обрезать его нечем, но и
    //      логарифм ему не нужен.
    //   2. Диск и ореол — общий `log2`. pow(x,k) это exp2(k*log2(x)),
    //      и логарифм у степеней одного основания один. Было пять
    //      логарифмов и пять экспонент, стало два и четыре.
    //   3. Ничего не выброшено: результат тот же до бита.
    float d  = max(dot(dir, cam.sunDir.xyz), 1e-4);
    float d2 = d * d;
    float ld = log2(d);
    sky += sunTint * (d2 * d2 * d2)   * 0.08 * above;   // широкое сияние
    sky += sunTint * exp2(900.0 * ld) * 3.00 * above;   // диск
    sky += sunTint * exp2( 48.0 * ld) * 0.30 * above;   // ореол

    // Луна — напротив солнца, видна ночью. Тот же общий логарифм.
    float m  = max(dot(dir, -cam.sunDir.xyz), 1e-4);
    float lm = log2(m);
    sky += vec3(0.72, 0.77, 1.0)  * exp2(2400.0 * lm) * 2.20 * night;
    sky += vec3(0.30, 0.36, 0.64) * exp2( 160.0 * lm) * 0.10 * night;


    // ============================================================
    // Тучи поверх всего неба
    // ============================================================
    //
    // Ветвь здесь по UNIFORM, а не по пикселю, и это важно: условие
    // одинаково для всего кадра, и драйвер снимает его скалярно, не
    // считая обе стороны. Предикация, о которой сказано выше, бьёт
    // по ветвям, РАЗНЫМ в пределах волны, — здесь такой нет.
    float cloudAmt = cam.weather.x;
    if (cloudAmt > 0.01) {
        // Слой на трёхстах блоках: выше — и облака уходят точками,
        // ниже — и они разъезжаются под ногами при взгляде вниз.
        float up2 = max(dir.y, 0.02);
        vec2 hit = cam.cameraPos.xz + dir.xz * (300.0 / up2);

        // Масштаб шума — не вкусовщина. При взгляде вверх луч
        // проходит по слою всего пару сотен блоков, и на клетке шума
        // в полкилометра всё небо оказывалось ВНУТРИ одной клетки:
        // ровная заливка без единого облака. Клетка в двести
        // пятьдесят блоков, а с третьей октавой — в шестьдесят.
        vec2 uv = hit * 0.004 - cam.wind.xy * cam.wind.z * 0.004;
        vec2  field = cloudField(uv);
        float n     = field.x;

        // Чем больше облачность, тем ниже порог: от редких клочьев
        // до сплошного полога, под которым неба не видно совсем.
        float lo = mix(0.62, 0.05, cloudAmt);
        float hi = lo + mix(0.22, 0.06, cloudAmt);
        float cover = smoothstep(lo, hi, n);

        // У самого горизонта слой уходит в бесконечность — там он
        // сплошной по построению; ниже горизонта его нет вовсе.
        cover *= smoothstep(-0.02, 0.10, dir.y);

        // ---- Толщина ----
        //
        // Цвет тучи не зависел от плотности ВООБЩЕ: на весь полог
        // был один тон, гулявший только по углу к солнцу, то есть
        // плавным градиентом через полнеба — одинаковым сразу для
        // всех облаков. Отсюда и бралось «небо одного цвета»: шум
        // решал, ГДЕ облако, и не решал, КАКОЕ оно.
        //
        // Даётся даром: n уже посчитан. Порог тот же, что у cover,
        // но верхний край выше — за ним начинается то, что сплошное
        // и просветов уже не даёт.
        float dens = smoothstep(lo, hi + 0.25, n);

        // ---- Тень от самого себя ----
        //
        // Пробуем шум СО СТОРОНЫ СОЛНЦА: гуще там — значит, этот
        // кусок стои́т за чужим боком и затенён; реже — значит, это
        // и есть освещённый бок. Одна октава: тени подробности не
        // нужны, а стоит она вчетверо меньше полной пробы.
        //
        // sunDir.xz НЕ нормируется, и намеренно: у высокого солнца
        // он короткий, смещение выходит меньше — ровно как
        // укорачивается настоящая тень в полдень. Нормировка это
        // свойство как раз и стёрла бы.
        float nSun  = vnoise(uv + cam.sunDir.xz * 0.05) * 0.55;
        float shade = clamp((nSun - field.y) * 7.0, -1.0, 1.0);

        // Освещение тучи: сверху её подсвечивает солнце, снизу она
        // серая. Без этого полог читается как плоская заливка.
        float lit = clamp(dot(dir, cam.sunDir.xyz) * 0.5 + 0.5, 0.0, 1.0);
        vec3 bright = mix(vec3(0.62, 0.64, 0.70), sunTint * 1.15, lit * 0.45 * above);
        vec3 dark   = vec3(0.17, 0.18, 0.22);
        vec3 cloudCol = mix(bright, dark, cloudAmt * 0.75);

        // Край клока просвечивает и потому светел; сквозь ядро свет
        // не проходит вовсе. Это и есть то, что отличает облако от
        // пятна краски.
        //
        // Края подобраны ЗАМЕРОМ, а не на глаз: считалась средняя
        // яркость полога на трёх погодах. При 1.22/0.74 размах тот
        // же, но сплошная облачность темнела на пятую часть — то
        // есть правка «про разнообразие» заодно перекрашивала
        // ненастье. При 1.30/0.86 средняя держится в пределах
        // десятой доли на всех трёх, а размах не теряется.
        cloudCol *= mix(1.30, 0.86, dens);

        // Собственная тень поверх — она и лепит объём из заливки.
        // Ночью её нет: лепить нечем.
        cloudCol *= 1.0 - shade * 0.30 * above;

        cloudCol *= (0.25 + 0.75 * cam.skyColor.w);

        // Солнце, луна и звёзды уходят ЗА тучу, а не светят сквозь.
        sky = mix(sky, cloudCol, cover);
    }

    // ============================================================
    // Радуга
    // ============================================================
    //
    // Дуга в сорок два градуса от точки, противоположной солнцу, —
    // это не подобранное число, а угол, под которым капля отдаёт
    // свет обратно. Оттого радуга и стоит всегда спиной к солнцу и
    // тем ниже, чем солнце выше.
    float rb = cam.weather.z;
    if (rb > 0.01) {
        float ang = degrees(acos(clamp(dot(dir, -cam.sunDir.xyz), -1.0, 1.0)));

        // Основная дуга: 40.5..42.4 градуса.
        float t = clamp((ang - 40.5) / 1.9, 0.0, 1.0);
        float band = smoothstep(40.3, 40.9, ang) * (1.0 - smoothstep(41.9, 42.6, ang));

        // Побочная дуга: шире, слабее и с обратным порядком цветов.
        float t2 = clamp(1.0 - (ang - 50.5) / 3.0, 0.0, 1.0);
        float band2 = smoothstep(50.2, 51.2, ang) * (1.0 - smoothstep(53.0, 54.0, ang));

        vec3 arc = rainbowTint(t) * band + rainbowTint(t2) * band2 * 0.35;

        // Ниже горизонта дуги нет: там нет ни капель, ни неба.
        arc *= smoothstep(-0.01, 0.08, dir.y);

        // И сквозь сплошную тучу её не видно.
        sky += arc * rb * (1.0 - cloudAmt * 0.8);
    }

    outColor = vec4(toSrgb(shoulder(sky)), 1.0);
}
