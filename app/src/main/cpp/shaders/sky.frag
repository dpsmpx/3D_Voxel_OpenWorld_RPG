#version 450

layout(set = 0, binding = 0) uniform CameraUbo {
    mat4 viewProj;
    mat4 invViewProj;
    vec4 cameraPos;
    vec4 screenSize;
    vec4 sunDir;
    vec4 fogParams;
    vec4 skyColor;     // цвет неба, sRGB; w — доля дня, 0 ночь, 1 день
    // Свет суток, посчитанный ОДИН раз за кадр в render::Camera::toUbo.
    // Раньше каждый фрагментный шейдер считал это сам, на каждый
    // пиксель, хотя зависит оно только от uniform. См. CameraUbo.
    vec4 sunLight;     // rgb — цвет солнца, линейный; w — день x над горизонтом
    vec4 ambLight;     // rgb — оттенок рассеянного света; w — его сила
    vec4 skyLinear;    // rgb — цвет неба, линейный; w — солнце над горизонтом
    // Погода. weather: x — доля неба под тучами, y — сила осадков,
    // z — яркость радуги, w — снег (0 дождь, 1 снег).
    // wind: xy — ветер в блоках в секунду, z — время в секундах,
    // w — зерно крапчатости блоков (см. render::tintSeedOf).
    vec4 weather;
    vec4 wind;

    // ---- Точечные источники: факелы, фонари, огонь в руке ----
    //
    // lightInfo.x — сколько источников прислали. Ноль — цикл в
    // шейдере не выполняется ни разу.
    vec4 lightInfo;
    vec4 lightPos[8];    // xyz — где, w — радиус гашения
    vec4 lightColor[8];  // rgb — цвет, линейный; w — яркость
} cam;

layout(location = 0) out vec4 outColor;

// ============================================================
// Облик неба — все числа, задающие форму, здесь
// ============================================================
//
// Принцип — «воксельная форма, а не воксельное всё». Само небо и свет
// суток остаются плавными: градиент к зениту, рассвет, закат, тёплая
// полоса у горизонта. Дискретны предметы в небе — солнце, луна,
// звёзды и облака: они собраны из крупных клеток, как всё в мире.
//
// Клетки привязаны к миру и к светилам, а не к экрану. Пикселизация
// экрана поверх готового неба дала бы 2D-фильтр: ступени плыли бы при
// повороте камеры и зависели от разрешения. Здесь поворот и ходьба
// клеток не двигают, а разрешение меняет только то, сколько пикселей
// ляжет в одну клетку.

// ---- Солнце: клетки в угловой мере, диск и три кольца свечения ----
const float SUN_CELL    = 0.0085;  // сторона клетки, радиан (~0.5°)
const float SUN_CORE    = 1.9;     // раскалённая середина, в клетках
const float SUN_RADIUS  = 3.6;     // диск
const float SUN_RING    = 5.3;     // ближнее свечение
const float SUN_HALO    = 8.1;     // дальнее свечение
const float SUN_GLOW    = 15.0;    // ореол; у горизонта он ярче и греет небо на закате

// ---- Луна: клетка мельче солнечной — рисунку нужно место ----
const float MOON_CELL   = 0.0072;
const float MOON_RADIUS = 4.6;
const float MOON_RING   = 6.1;
const float MOON_HALO   = 8.6;

// ---- Звёзды: квадратные точки на сетке направлений ----
const float STAR_GRID   = 200.0;   // клеток на радиан у горизонта
const float STAR_CHANCE = 0.0010;  // доля клеток со звездой у горизонта

// ---- Облака: клетки мира, столбы высотой в ярусы ----
const float CLOUD_BASE   = 165.0;  // низ облаков, мировая высота
const float CLOUD_STEP   = 9.0;    // ярус, блоков
const int   CLOUD_LAYERS = 2;      // ярусов = проб луча
const float CLOUD_CELL   = 12.0;   // клетка облака по горизонтали, блоков
const float CLOUD_MASS   = 6.0;    // массив облаков, в клетках; целое
const float CLOUD_EDGE   = 0.10;   // доля хэша клетки: неровность края
const float CLOUD_TIER   = 0.07;   // плотность сверх порога на ярус вверх
const float CLOUD_FAR_PX = 2.5;    // клетка меньше стольких пикселей — ступени сглаживаются
// Тона граней, три уровня: низ в тени, бок к солнцу, бок от солнца.
const float CLOUD_UNDER  = 0.66;
const float CLOUD_LIT    = 1.00;
const float CLOUD_SHADE  = 0.82;
const float CLOUD_CORE   = 0.14;   // плотное ядро темнее на столько
const float CLOUD_NIGHT  = 0.18;   // свет облака без солнца, к дневному

// Небо считается в том же линейном пространстве, что и мир: у
// горизонта туман должен переходить в небо незаметно, а он приходит
// оттуда линейным. Разные пространства дали бы видимый стык по
// линии горизонта.
vec3 toLinear(vec3 c) { return c * c; }
vec3 toSrgb(vec3 c)   { return sqrt(max(c, vec3(0.0))); }

// Хэш клетки: на входе целые координаты. Привычный
// fract(p * vec2(123.34, 456.21)) на целых повторяется через три
// клетки — звёзды и края облаков от него ложились полосами. Здесь
// множители около 0.1 (как в hash12 без синуса, Dave Hoskins), а
// последнее произведение несимметрично по x и y — иначе рисунок
// зеркалился бы по диагонали. Целочисленный хэш точнее, но на замере
// (tools/gpubench) облака с ним стали почти вдвое дороже.
float hash21(vec2 p) {
    vec2 q = fract(p * vec2(0.1031, 0.1030));
    q += dot(q, q.yx + 33.33);
    return fract((q.x + q.y) * q.x);
}

// Медленный шум облаков — в два шага, чтобы один и тот же квадрат
// решётки служил и ступенчатой плотности клетки, и гладкой плотности
// дальнего поля: четыре хэша на обе.
vec4 latticeCorners(vec2 i) {
    return vec4(hash21(i), hash21(i + vec2(1.0, 0.0)),
                hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0, 1.0)));
}

float latticeLerp(vec4 c, vec2 f) {
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(c.x, c.y, f.x), mix(c.z, c.w, f.x), f.y);
}

// Касательная плоскость к небу в точке солнца: луч в её осях и
// косинус угла до солнца. Ось X лежит вдоль горизонта — диск стоит
// «ровно», как блоки мира. Луна — ровно напротив солнца, её плоскость
// та же, только X и косинус с обратным знаком: оси считаются один
// раз на оба светила.
vec3 sunFrame(vec3 dir, vec3 sun) {
    vec3 side = cross(sun, vec3(0.0, 1.0, 0.0));
    // В зените горизонтальная ось не определена — любая годится.
    side = dot(side, side) > 1e-6 ? normalize(side) : vec3(1.0, 0.0, 0.0);
    return vec3(dot(dir, side), dot(dir, cross(side, sun)), dot(dir, sun));
}

// Клетка светила, в которую смотрит луч; f — sunFrame, повёрнутая к
// светилу. Сетка едет вместе со светилом, поэтому рисунок внутри
// диска не ползёт, пока оно идёт по небу. xy — середина клетки в
// клетках от центра; z — светило перед глазом.
vec3 bodyCell(vec3 f, float cell) {
    vec2 p = f.xy / (max(f.z, 1e-3) * cell);
    return vec3(floor(p) + 0.5, step(0.0, f.z));
}

// Цвет радуги по углу внутри дуги: 0 — внутренний край (фиолетовый),
// 1 — внешний (красный). Не спектр по длине волны, а три полосы:
// в пять-шесть градусов дуги подробнее всё равно не видно.
vec3 rainbowTint(float t) {
    vec3 c = mix(vec3(0.35, 0.10, 0.70), vec3(0.10, 0.55, 0.35),
                 smoothstep(0.0, 0.45, t));
    c = mix(c, vec3(0.95, 0.75, 0.15), smoothstep(0.40, 0.75, t));
    c = mix(c, vec3(0.95, 0.25, 0.12), smoothstep(0.70, 1.0, t));
    return c;
}

vec3 shoulder(vec3 c) {
    float m = max(max(c.r, c.g), c.b);
    if (m <= 0.75) return c;
    float o = m - 0.75;
    return c * ((0.75 + o / (1.0 + o * 2.0)) / m);
}

void main() {
    // NDC из gl_FragCoord. В Vulkan начало кадра — левый ВЕРХНИЙ угол,
    // и там же -1 по Y, поэтому перевод прямой, без переворота.
    // Экранные координаты нужны только здесь — чтобы найти луч; всё
    // дискретное ниже считается по лучу, в мире.
    vec2 uv  = gl_FragCoord.xy / cam.screenSize.xy;
    vec2 ndc = uv * 2.0 - 1.0;

    vec4 nearH = cam.invViewProj * vec4(ndc, 0.0, 1.0);
    vec4 farH  = cam.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 dir = normalize(farH.xyz / farH.w - nearH.xyz / nearH.w);

    // Свет суток приходит готовым: считает его render::Camera::toUbo,
    // раз в кадр, и одинаково для неба, ландшафта, растений и существ.
    float night   = 1.0 - cam.skyColor.w;
    float above   = cam.skyLinear.w;
    vec3  sunTint = cam.sunLight.rgb;

    // ============================================================
    // Атмосфера — плавная
    // ============================================================
    //
    // Градиент от горизонта к зениту. Базовый цвет приходит из
    // world::DayCycle, поэтому небо само меняется от ночного индиго
    // к рассветному янтарю и дневной лазури. Корень вместо прежней
    // степени 0.55: на глаз то же, а логарифма с экспонентой нет.
    float up = clamp(dir.y, -1.0, 1.0);
    vec3 horizon = cam.skyLinear.rgb;
    vec3 zenith  = horizon * vec3(0.42, 0.60, 1.10);
    vec3 sky = mix(horizon, zenith, sqrt(max(up, 0.0)));

    // Под горизонтом — земляная дымка: без неё при взгляде вниз
    // сквозь дальний край мира светит чистое небо, и видно, где он
    // кончается.
    sky = mix(sky, horizon * 0.55, 1.0 - smoothstep(-0.25, 0.0, up));

    // Тёплая полоса у самого горизонта в стороне солнца — то, из-за
    // чего рассвет читается как рассвет.
    float toSun = max(dot(normalize(vec3(dir.x, 0.0, dir.z)),
                          normalize(vec3(cam.sunDir.x, 0.0, cam.sunDir.z))), 0.0);
    sky = mix(sky, sunTint, exp(-abs(up) * 7.0) * (toSun * toSun * toSun) * 0.55 * above);

    // Широкое сияние вокруг солнца — часть атмосферы, а не светила:
    // оно остаётся плавным. Шестая степень — три умножения.
    float d  = max(dot(dir, cam.sunDir.xyz), 0.0);
    float d2 = d * d;
    sky += sunTint * (d2 * d2 * d2) * 0.08 * above;

    // ============================================================
    // Звёзды — квадратные точки
    // ============================================================
    //
    // Сетка — в мировых направлениях: стереографическая проекция
    // верхней полусферы на плоскость, звезда стоит в своей клетке при
    // любом повороте камеры. Проекция конформна — квадрат клетки на
    // небе остаётся квадратом, и швов, как у граней куба, нет. К зениту
    // клетка вдвое крупнее (s — от 1 у горизонта до 2): шанс и размер
    // звезды поправлены на s, и звёзд по небу поровну.
    //
    // Размер — в угловой мере, но не меньше пикселя: иначе на мелком
    // экране точка мерцала бы, попадая то в пиксель, то мимо.
    //
    // Ветвь — по uniform: днём звёзд не считается вовсе.
    if (night > 0.01) {
        float s = 1.0 + max(dir.y, 0.0);
        vec2 g = dir.xz * (STAR_GRID / s);
        float chance = STAR_CHANCE * s * s;
        vec2 cell = floor(g);
        float h = hash21(cell);
        // Облик звезды — не вторым хэшем, а последовательностью R2:
        // соседние клетки получают разные числа, а звёзды редки, и
        // закономерность между ними не видна.
        float r = fract(dot(cell, vec2(0.7548777, 0.5698403)));
        // Три размера: мелкие, средние и редкие крупные.
        float fw = max(fwidth(g.x), fwidth(g.y));
        float size = (0.18 + 0.10 * step(0.72, r) + 0.12 * step(0.94, r)) / s;
        size = max(size, min(0.5 * fw, 0.5));
        // Звезда не в середине клетки: иначе небо читается сеткой.
        vec2 off = abs(fract(g) - 0.5 - (vec2(fract(r * 37.1), fract(r * 71.3)) - 0.5) * 0.3);
        // Край квадрата — долей пикселя, а не ступенью: точка в
        // пиксель-полтора иначе выходила то 1x1, то 1x2 и мигала при
        // повороте, переползая через границу пикселя.
        float star = step(h, chance)
                   * clamp((size - max(off.x, off.y)) / fw + 0.5, 0.0, 1.0);
        // Неравная яркость и лёгкий оттенок: ровная сетка одинаковых
        // точек читается как шум, а не как небо.
        float mag = 0.35 + 0.65 * fract(r * 13.7);
        vec3 tint = mix(vec3(0.85, 0.90, 1.0), vec3(1.0, 0.88, 0.72), step(0.8, fract(r * 5.3)));
        sky += tint * (star * mag * night * smoothstep(0.0, 0.08, up));
    }

    // ============================================================
    // Солнце — ступенчатый диск и кольца свечения
    // ============================================================
    //
    // Каждая клетка решает по своей середине: внутри круга она или нет.
    // Отсюда ступенчатый круг, а не квадрат и не гладкий диск; ореол —
    // три ступени яркости вместо прежнего плавного. Ни одной степени:
    // прежние диск и ореол стоили двух логарифмов и четырёх экспонент
    // на пиксель, здесь — скалярные произведения и сравнения.
    //
    // Радиусы сравниваются в квадрате — без корня. Ветвь по uniform:
    // ночью, когда солнце под горизонтом, диска не считается.
    vec3 frame = sunFrame(dir, cam.sunDir.xyz);
    if (above > 0.0) {
        vec3 sc = bodyCell(frame, SUN_CELL);
        float sr = dot(sc.xy, sc.xy);
        float sunDisc = step(sr, SUN_RADIUS * SUN_RADIUS);
        float sunCore = step(sr, SUN_CORE * SUN_CORE);
        float sunRing = step(sr, SUN_RING * SUN_RING) - sunDisc;
        float sunHalo = step(sr, SUN_HALO * SUN_HALO) - step(sr, SUN_RING * SUN_RING);
        float sunGlow = step(sr, SUN_GLOW * SUN_GLOW) - step(sr, SUN_HALO * SUN_HALO);
        // Низкое солнце светит сквозь толщу воздуха, и ореол у него шире
        // заметен: на закате именно он греет небо вокруг диска.
        float low = 1.0 - smoothstep(0.0, 0.3, cam.sunDir.y);
        sky += sunTint * ((sunDisc * 2.6 + sunCore * 1.4 + sunRing * 0.42 + sunHalo * 0.20
                           + sunGlow * (0.07 + 0.16 * low)) * sc.z * above);
    }

    // ============================================================
    // Луна — ступенчатый диск с морями и кратером
    // ============================================================
    //
    // Напротив солнца, видна ночью. Рисунок — три тёмных пятна и
    // кратер в клетках самой луны: простые круги, решённые по
    // серединам клеток, как и край диска.
    //
    // Фаз нет: луна всегда напротив солнца, то есть полная. Фаза, если
    // понадобится, — это ещё одна маска по клеткам (освещённая доля
    // диска), умноженная на moonTone.
    //
    // Ветвь по uniform: днём луны не считается.
    if (night > 0.01) {
        vec3 mc = bodyCell(vec3(-frame.x, frame.y, -frame.z), MOON_CELL);
        vec2 q = mc.xy;
        float mr = dot(q, q);
        float moonDisc = step(mr, MOON_RADIUS * MOON_RADIUS);
        vec2 m1 = q - vec2(-1.0, 1.0), m2 = q - vec2(1.5, -1.0), m3 = q - vec2(-1.5, -2.5);
        vec2 cr = q - vec2(2.0, 2.0);
        float mare = min(step(dot(m1, m1), 1.9 * 1.9) + step(dot(m2, m2), 1.3 * 1.3)
                       + step(dot(m3, m3), 1.0), 1.0);
        float crater = step(dot(cr, cr), 0.8 * 0.8);
        float moonTone = (1.0 - 0.36 * mare) * (1.0 - 0.35 * crater);
        float moonRing = step(mr, MOON_RING * MOON_RING) - moonDisc;
        float moonHalo = step(mr, MOON_HALO * MOON_HALO) - step(mr, MOON_RING * MOON_RING);
        sky += (vec3(0.72, 0.77, 1.0) * (moonDisc * moonTone * 2.0)
              + vec3(0.30, 0.36, 0.64) * (moonRing * 0.16 + moonHalo * 0.06)) * (mc.z * night);
    }

    // ============================================================
    // Облака — клетки мира
    // ============================================================
    //
    // Облачный слой — столбы над сеткой мира в CLOUD_CELL блоков, от
    // мировой высоты CLOUD_BASE вверх. Плотность — одна на клетку,
    // и чем плотнее клетка, тем выше её столб (CLOUD_TIER на ярус):
    // массивы с плоским низом и ступенчатым верхом. Край ступенчатый
    // потому, что клетка целиком решает по плотности в своей
    // середине, а не потому, что шум рваный. Ветер двигает сетку
    // вместе с облаками — форма плывёт, а не переливается сквозь
    // неподвижные клетки.
    //
    // Объёма без марша по лучу: луч пробует столбы на CLOUD_LAYERS
    // высотах. Первый ярус снизу, где столб есть, — то, что видно:
    // на нижнем — низ облака, выше — бок столба, в который луч вошёл
    // сбоку. Бок к солнцу светлее, от солнца темнее; три тона, а не
    // плавная заливка.
    //
    // Ветвь — по uniform: при ясной погоде облаков не считается вовсе.
    float cloudAmt = cam.weather.x;
    if (cloudAmt > 0.01) {
        // Чем облачнее, тем ниже порог: от редких кучевых до сплошного
        // полога со ступенчатым низом.
        float thr   = mix(0.86, 0.20, cloudAmt);
        float invUp = 1.0 / max(dir.y, 0.015);
        vec2  drift = cam.wind.xy * cam.wind.z;

        float layer = 0.0;     // ярус, где луч вошёл в облако, с единицы; 0 — мимо
        float nHit = 0.0, nFar = 0.0;
        vec2  dcHit = vec2(0.0), p0 = vec2(0.0), prev = vec2(0.0);
        for (int k = 0; k < CLOUD_LAYERS; ++k) {
            float t = (CLOUD_BASE + float(k) * CLOUD_STEP - cam.cameraPos.y) * invUp;
            vec2 p = cam.cameraPos.xz + dir.xz * t - drift;
            vec2 cell = floor(p * (1.0 / CLOUD_CELL));
            // Плотность в середине клетки. Квадрат решётки шума для
            // середины и для самой точки один и тот же (CLOUD_MASS —
            // целое), поэтому нижний ярус заодно даёт гладкую плотность
            // для дальнего поля — без второго набора хэшей.
            vec2 m = (cell + 0.5) * (1.0 / CLOUD_MASS);
            vec2 i = floor(m);
            vec4 corners = latticeCorners(i);
            float n = latticeLerp(corners, m - i) * (1.0 - CLOUD_EDGE) + hash21(cell) * CLOUD_EDGE;
            if (k == 0) {
                p0 = p;
                vec2 f = clamp(p * (1.0 / (CLOUD_CELL * CLOUD_MASS)) - i, 0.0, 1.0);
                nFar = latticeLerp(corners, f) * (1.0 - CLOUD_EDGE) + 0.5 * CLOUD_EDGE;
            }
            float hit = step(thr + float(k) * CLOUD_TIER, n) * step(layer, 0.5);
            layer = mix(layer, float(k + 1), hit);
            nHit  = mix(nHit, n, hit);
            dcHit = mix(dcHit, abs(cell - prev), hit);
            prev = cell;
        }
        float cover = step(0.5, layer);
        // Выше нижнего яруса луч вошёл в бок столба. Ось, по которой
        // он сменил клетку с прошлого яруса, и есть нормаль грани; бок
        // к солнцу светлее, от солнца темнее.
        vec2 nrm = dcHit.x >= dcHit.y ? vec2(-sign(dir.x), 0.0) : vec2(0.0, -sign(dir.z));
        float tone = layer < 1.5 ? CLOUD_UNDER
                   : mix(CLOUD_SHADE, CLOUD_LIT, step(0.0, dot(nrm, cam.sunDir.xz)));
        // Плотное ядро темнее — ступенью, а не градиентом.
        tone *= 1.0 - CLOUD_CORE * step(thr + 2.5 * CLOUD_TIER, nHit);

        // Вдали клетка сжимается до пары пикселей, и её ступени
        // начинают мерцать при каждом движении. Там — то же поле,
        // но плавно: форма массивов та же, без мелкой ступени.
        // Мерило — площадь пикселя на слое облаков: у горизонта
        // клетка сплющена, и по одной оси она ещё крупная.
        vec2 dx = dFdx(p0), dy = dFdy(p0);
        float foot = sqrt(abs(dx.x * dy.y - dx.y * dy.x));   // блоков на пиксель
        float far = smoothstep(CLOUD_CELL / (2.0 * CLOUD_FAR_PX), CLOUD_CELL / CLOUD_FAR_PX, foot);
        cover = mix(cover, smoothstep(thr - 0.10, thr + 0.10, nFar), far);
        tone  = mix(tone, 0.5 * (CLOUD_UNDER + CLOUD_SHADE), far);

        // Цвет: белое, тронутое солнцем, — к ненастью серое. Светит
        // облако светом суток: доля дня (ночью она не ноль, а лунные
        // 0.12) и солнце над горизонтом. Ночью от облака остаётся
        // тёмная серая масса чуть светлее неба — отражённая синева, а
        // не светлое пятно поверх звёзд.
        vec3 white = mix(vec3(0.80, 0.82, 0.88), sunTint * 1.15, 0.35 * above);
        vec3 cloudCol = mix(white, vec3(0.30, 0.31, 0.36), cloudAmt * cloudAmt * 0.8) * tone;
        cloudCol = cloudCol * (cam.skyColor.w * mix(CLOUD_NIGHT, 1.0, above))
                 + horizon * (0.80 * night);

        // Дальние облака растворяются в дымке горизонта.
        float dist = (CLOUD_BASE - cam.cameraPos.y) * invUp;
        cloudCol = mix(cloudCol, horizon, smoothstep(500.0, 2000.0, dist) * 0.75);

        // Ниже горизонта облаков нет, у самого горизонта слой сходится.
        cover *= smoothstep(-0.02, 0.10, dir.y);

        // Солнце, луна и звёзды уходят ЗА тучу, а не светят сквозь.
        sky = mix(sky, cloudCol, cover);
    }

    // ============================================================
    // Радуга
    // ============================================================
    //
    // Дуга в сорок два градуса от точки, противоположной солнцу, —
    // это не подобранное число, а угол, под которым капля отдаёт
    // свет обратно. Оттого радуга и стоит всегда спиной к солнцу и
    // тем ниже, чем солнце выше.
    float rb = cam.weather.z;
    if (rb > 0.01) {
        float ang = degrees(acos(clamp(dot(dir, -cam.sunDir.xyz), -1.0, 1.0)));

        // Основная дуга: 40.5..42.4 градуса.
        float t = clamp((ang - 40.5) / 1.9, 0.0, 1.0);
        float band = smoothstep(40.3, 40.9, ang) * (1.0 - smoothstep(41.9, 42.6, ang));

        // Побочная дуга: шире, слабее и с обратным порядком цветов.
        float t2 = clamp(1.0 - (ang - 50.5) / 3.0, 0.0, 1.0);
        float band2 = smoothstep(50.2, 51.2, ang) * (1.0 - smoothstep(53.0, 54.0, ang));

        vec3 arc = rainbowTint(t) * band + rainbowTint(t2) * band2 * 0.35;

        // Ниже горизонта дуги нет: там нет ни капель, ни неба.
        arc *= smoothstep(-0.01, 0.08, dir.y);

        // И сквозь сплошную тучу её не видно.
        sky += arc * rb * (1.0 - cloudAmt * 0.8);
    }

    outColor = vec4(toSrgb(shoulder(sky)), 1.0);
}
