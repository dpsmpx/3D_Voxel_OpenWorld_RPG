#!/data/data/com.termux/files/usr/bin/bash
# Скрипт сборки VoxelRPG в Termux
# Требуется: pkg install termux-ndk cmake ninja git clang

set -e

# --- Настройка окружения ---
export ANDROID_NDK_HOME=${ANDROID_NDK_HOME:-$PREFIX/lib/android-ndk}
export ANDROID_HOME=${ANDROID_HOME:-$HOME/android-sdk}
TOOLCHAIN=$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-aarch64
export PATH="$TOOLCHAIN/bin:$PATH"

PROJ=$(cd "$(dirname "$0")" && pwd)
BUILD=$PROJ/build
ABI=arm64-v8a
API=24

echo "==> Проект: $PROJ"
echo "==> NDK:    $ANDROID_NDK_HOME"

# --- Проверка GLM ---
if [ ! -d "$PROJ/third_party/glm" ]; then
    echo "==> Клонирую glm..."
    mkdir -p "$PROJ/third_party"
    git clone --depth=1 https://github.com/g-truc/glm.git "$PROJ/third_party/glm"
fi

# --- Компиляция шейдеров ---
SHADERS_SRC="$PROJ/app/src/main/cpp/shaders"
SHADERS_OUT="$PROJ/app/src/main/assets/shaders"
mkdir -p "$SHADERS_OUT"
if command -v glslc >/dev/null 2>&1; then
    for f in "$SHADERS_SRC"/*.vert "$SHADERS_SRC"/*.frag; do
        [ -f "$f" ] || continue
        base=$(basename "$f")
        echo "==> glslc: $base"
        glslc -O "$f" -o "$SHADERS_OUT/${base}.spv"
    done
else
    echo "!! glslc не найден — шейдеры не скомпилированы"
fi

# --- CMake ---
mkdir -p "$BUILD"
cd "$BUILD"

cmake "$PROJ/app/src/main/cpp" \
    -G Ninja \
    -DCMAKE_TOOLCHAIN_FILE="$ANDROID_NDK_HOME/build/cmake/android.toolchain.cmake" \
    -DANDROID_ABI=$ABI \
    -DANDROID_PLATFORM=android-$API \
    -DCMAKE_BUILD_TYPE=Release -DANDROID_STL=c++_shared -DCMAKE_EXE_LINKER_FLAGS="-L/data/data/com.termux/files/usr/lib" -DCMAKE_SHARED_LINKER_FLAGS="-L/data/data/com.termux/files/usr/lib"

ninja -j$(nproc)

# --- Копирование .so в APK-структуру ---
mkdir -p "$PROJ/app/src/main/jniLibs/$ABI"
cp libnative-lib.so "$PROJ/app/src/main/jniLibs/$ABI/"

echo
echo "==> Сборка успешна: libnative-lib.so"
echo "==> Размер: $(du -h libnative-lib.so | cut -f1)"
echo
echo "Дальше: cd $PROJ/app && gradle assembleDebug"